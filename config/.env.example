# Необязательные overrides для развёртывания. Для обычной настройки .env не нужен.
# Режим и account ID сохраняются в data/redbot.duckdb через GUI/CLI.
# Токен предпочтительно хранить в системном keyring: redbot secrets set-token.
# Если токен передаётся через REDBOT_TBANK__API_TOKEN, используйте только secret store/ENV,
# никогда не коммитьте реальное значение и не выводите его в логи.

# --- Хранилище ---------------------------------------------------------
REDBOT_STORAGE__DATA_DIR=data
REDBOT_STORAGE__DUCKDB_MEMORY_LIMIT_MB=1536
REDBOT_STORAGE__DUCKDB_THREADS=2
REDBOT_STORAGE__DISK_USAGE_THRESHOLD_PCT=0.8
REDBOT_STORAGE__HOT_RETENTION_DAYS=1
REDBOT_STORAGE__WARM_RETENTION_DAYS=180

# --- Web GUI (при необходимости) ---------------------------------------
REDBOT_WEB__HOST=127.0.0.1
REDBOT_WEB__PORT=8000
# Секрет нужен только если задаёте отдельный пароль GUI.
# REDBOT_WEB__SESSION_SECRET=<secret-from-password-manager>

# --- Логирование -------------------------------------------------------
REDBOT_LOG_LEVEL=info
