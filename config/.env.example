# Шаблон bootstrap-конфигурации. Скопируйте в .env и заполните.
# Реальный .env НЕ коммитится (см. .gitignore).

# Контур исполнения: live | sandbox | backtest
REDBOT_EXECUTION_MODE=sandbox

# --- T-Bank Invest API -------------------------------------------------
# Токен: в боевом режиме рекомендуется хранить в keyring, а не здесь.
#   python -m adapters.driving.cli.main secrets set-token
REDBOT_TBANK__API_TOKEN=changeme
# Единственный счёт, с которым разрешено работать боту.
REDBOT_TBANK__ACCOUNT_ID=changeme
# Аварийный люк: отключение проверки TLS. Заблокирован при execution_mode=live.
REDBOT_TBANK__INSECURE_TLS_DEV_ONLY=false

# --- Хранилище ---------------------------------------------------------
REDBOT_STORAGE__DATA_DIR=data
REDBOT_STORAGE__DUCKDB_MEMORY_LIMIT_MB=1536
REDBOT_STORAGE__DUCKDB_THREADS=2
REDBOT_STORAGE__DISK_USAGE_THRESHOLD_PCT=0.8
REDBOT_STORAGE__HOT_RETENTION_DAYS=1
REDBOT_STORAGE__WARM_RETENTION_DAYS=180

# --- Риск-дефолты (seed для operational config) ------------------------
REDBOT_RISK_DEFAULTS__COMMISSION_RATE=0.003
REDBOT_RISK_DEFAULTS__MIN_VIABLE_TARGET_MULTIPLIER=2.0
REDBOT_RISK_DEFAULTS__MAX_RISK_PER_TRADE_PCT=0.01
REDBOT_RISK_DEFAULTS__HYPOTHESIS_MIN_SAMPLE_SIZE=30
REDBOT_RISK_DEFAULTS__WALK_FORWARD_CONFIRMATION_THRESHOLD=0.5

# --- Web GUI -----------------------------------------------------------
REDBOT_WEB__HOST=127.0.0.1
REDBOT_WEB__PORT=8000
REDBOT_WEB__SESSION_SECRET=changeme

# --- Прочее -----------------------------------------------------------
REDBOT_LOG_LEVEL=info
